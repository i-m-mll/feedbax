{
  "schema": "feedbax.spec.task_document.v2",
  "label": "Campaign reaches",
  "payload": {
    "id": "delayed-reaches",
    "variables": {
      "start": {
        "label": "Start",
        "type": {"base": "real", "shape": [2], "dimensions": {"length": 1}, "space": "point"},
        "value": "[U(-0.4, 0.5), U(-0.3, 0.45)]"
      },
      "target": {
        "label": "Target",
        "type": {"base": "real", "shape": [2], "dimensions": {"length": 1}, "space": "point"},
        "value": "start + polar(0.2 m, choice(0°, 90°, 180°, 270°))"
      },
      "catch": {"label": "Catch", "type": {"base": "boolean"}, "value": "B(0.5)"}
    },
    "epochs": {
      "hold": {
        "label": "Hold",
        "end": {"kind": "length", "length": "U(5 st, 14 st)", "max_steps": 14}
      },
      "cue": {
        "label": "Cue",
        "end": {"kind": "length", "length": "U(10 st, 19 st)", "max_steps": 19}
      },
      "move": {"label": "Move", "end": {"kind": "rest"}}
    },
    "signals": {
      "target_pos": {
        "label": "Target position",
        "type": {"base": "real", "shape": [2], "dimensions": {"length": 1}, "space": "point"},
        "cells": {"cue-move": {"first_epoch": "cue", "last_epoch": "move", "value": "target"}}
      },
      "target_vel": {
        "label": "Target velocity",
        "type": {
          "base": "real",
          "shape": [2],
          "dimensions": {"length": 1, "time": -1},
          "space": "free"
        },
        "cells": {"cue-move": {"first_epoch": "cue", "last_epoch": "move", "value": "[0, 0]"}}
      },
      "goal": {
        "label": "Goal",
        "type": {"base": "real", "shape": [2], "dimensions": {"length": 1}, "space": "point"},
        "cells": {
          "hold-cue": {"first_epoch": "hold", "last_epoch": "cue", "value": "start"},
          "move": {
            "first_epoch": "move",
            "last_epoch": "move",
            "value": "where(catch, start, target)"
          }
        }
      },
      "fixation": {
        "label": "Fixation",
        "type": {"base": "real"},
        "cells": {
          "hold-cue": {"first_epoch": "hold", "last_epoch": "cue", "value": 1},
          "move": {"first_epoch": "move", "last_epoch": "move", "value": "where(catch, 1, 0)"}
        }
      },
      "target_on": {
        "label": "Target on",
        "type": {"base": "real"},
        "cells": {"cue-move": {"first_epoch": "cue", "last_epoch": "move", "value": 1}}
      }
    },
    "links": {"component.plant.state.\"effector/position\"": "start"},
    "fixed_steps": 80,
    "validation_trials": {
      "reach": {
        "over": {"direction": "0..3", "repeat": "0..1"},
        "label": "Reach {direction}, draw {repeat}",
        "variables": {"start": "[0, 0]", "target": "polar(0.2 m, direction * 90°)", "catch": false},
        "epoch_steps": {"hold": "7 + repeat", "cue": 10}
      }
    }
  }
}
