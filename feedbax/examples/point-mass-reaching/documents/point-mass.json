        "hand": {
          "source": {
            "owner": "component",
            "component": "position",
            "port": "output"
          },
          "target": {
            "owner": "outputs",
            "port": "hand"
          }
        },
        "record-velocity": {
          "source": {
            "owner": "component",
            "component": "velocity",
            "port": "output"
          },
          "target": {
            "owner": "outputs",
            "port": "velocity"
          }
        },
        "command": {
          "source": {
            "owner": "component",
            "component": "readout",
            "port": "output"
          },
          "target": {
            "owner": "outputs",
            "port": "command"
          }
        },
        "activity": {
          "source": {
            "owner": "component",
            "component": "cell",
            "port": "output"
          },
          "target": {
            "owner": "outputs",
            "port": "activity"
          }
        }
