{
  "schema": "feedbax.spec.model",
  "label": "Point mass",
  "payload": {
    "step_seconds": 0.01,
    "ports": {
      "inputs": [
        {
          "id": "target_pos",
          "name": "target_pos",
          "type": {
            "shape": [
              2
            ],
            "unit": "m",
            "space": "point"
          }
        }
      ],
      "outputs": [
        {
          "id": "effector",
          "name": "effector",
          "type": {}
        },
        {
          "id": "command",
          "name": "command",
          "type": {
            "shape": [
              2
            ]
          }
        },
        {
          "id": "activity",
          "name": "activity",
          "type": {
            "shape": [
              4
            ]
          }
        }
      ]
    },
    "interior": {
      "components": {
        "plant": {
          "kind": "leaf",
          "name": "Point mass",
          "type": "feedbax.PointMass",
          "fields": {
            "mass": 1.0
          }
        },
        "hand-feedback": {
          "kind": "leaf",
          "name": "Hand feedback",
          "type": "feedbax.SelectState",
          "fields": {
            "paths": [
              "pos",
              "vel"
            ]
          }
        },
        "feedback": {
          "kind": "leaf",
          "name": "Feedback inputs",
          "type": "feedbax.Concatenate",
          "fields": {
            "n_inputs": 2
          }
        },
        "cell": {
          "kind": "leaf",
          "name": "Recurrent controller",
          "type": "feedbax.GRU",
          "fields": {
            "hidden_size": 4
          }
        },
        "readout": {
          "kind": "leaf",
          "name": "Motor command",
          "type": "feedbax.Linear",
          "fields": {
            "output_size": 2
          }
        }
      },
      "wires": {
        "target": {
          "source": {
            "owner": "inputs",
            "port": "target_pos"
          },
          "target": {
            "owner": "component",
            "component": "feedback",
            "port": "in_0"
          }
        },
        "sense-hand": {
          "source": {
            "owner": "component",
            "component": "plant",
            "port": "effector"
          },
          "target": {
            "owner": "component",
            "component": "hand-feedback",
            "port": "state"
          }
        },
        "pack-hand": {
          "source": {
            "owner": "component",
            "component": "hand-feedback",
            "port": "output"
          },
          "target": {
            "owner": "component",
            "component": "feedback",
            "port": "in_1"
          }
        },
        "controller-input": {
          "source": {
            "owner": "component",
            "component": "feedback",
            "port": "output"
          },
          "target": {
            "owner": "component",
            "component": "cell",
            "port": "input"
          }
        },
        "decode": {
          "source": {
            "owner": "component",
            "component": "cell",
            "port": "output"
          },
          "target": {
            "owner": "component",
            "component": "readout",
            "port": "input"
          }
        },
        "drive": {
          "source": {
            "owner": "component",
            "component": "readout",
            "port": "output"
          },
          "target": {
            "owner": "component",
            "component": "plant",
            "port": "force"
          }
        },
        "effector": {
          "source": {
            "owner": "component",
            "component": "plant",
            "port": "effector"
          },
          "target": {
            "owner": "outputs",
            "port": "effector"
          }
        },
        "command": {
          "source": {
            "owner": "component",
            "component": "readout",
            "port": "output"
          },
          "target": {
            "owner": "outputs",
            "port": "command"
          }
        },
        "activity": {
          "source": {
            "owner": "component",
            "component": "cell",
            "port": "output"
          },
          "target": {
            "owner": "outputs",
            "port": "activity"
          }
        }
      }
    }
  }
}
