{
  "schema": "feedbax.spec.objective_document.v2",
  "label": "Simple reaches",
  "payload": {
    "id": "simple-reaches",
    "terms": {
      "effector_position": {
        "measure": "sqnorm(outputs.effector.pos - goal)",
        "measure_type": {"base": "real", "dimensions": {"length": 2}},
        "weight": "(u + 0.0125) * (u + 0.0125) * (u + 0.0125) * (u + 0.0125) * (u + 0.0125) * (u + 0.0125)",
        "reduction": "sum"
      },
      "effector_final_velocity": {
        "measure": "sqnorm(outputs.effector.vel)",
        "measure_type": {"base": "real", "dimensions": {"length": 2, "time": -2}},
        "reduction": "last"
      },
      "nn_output": {"measure": "sqnorm(outputs.command)", "weight": 0.00001, "reduction": "sum"},
      "nn_hidden": {"measure": "sqnorm(outputs.activity)", "weight": 0.00001, "reduction": "sum"}
    }
  }
}
