{
  "schema": "feedbax.spec.objective_document.v2",
  "label": "Delayed reaches",
  "payload": {
    "id": "delayed-reaches",
    "terms": {
      "effector_fixation": {
        "measure": "sqnorm(outputs.effector.pos - goal) * fixation",
        "measure_type": {"base": "real", "dimensions": {"length": 2}},
        "reduction": "sum"
      },
      "effector_position": {
        "measure": "sqnorm(outputs.effector.pos - goal)",
        "measure_type": {"base": "real", "dimensions": {"length": 2}},
        "reduction": "sum"
      },
      "effector_final_velocity": {
        "measure": "sqnorm(outputs.effector.vel)",
        "measure_type": {"base": "real", "dimensions": {"length": 2, "time": -2}},
        "reduction": "last",
        "window": {
          "spans": [
            {"kind": "moment", "at": {"anchor": {"kind": "epoch", "epoch": "move", "edge": "end"}}}
          ]
        }
      },
      "nn_output": {"measure": "sqnorm(outputs.command)", "weight": 0.0001, "reduction": "sum"},
      "nn_hidden": {"measure": "sqnorm(outputs.activity)", "weight": 0.00001, "reduction": "sum"}
    }
  }
}
