{
  "schema_id": "feedbax.spec.authoring_budget",
  "schema_version": "feedbax.spec.authoring_budget.v2",
  "budget_id": "quillon.envelope_budgets.v1",
  "rationale": "A training envelope states a native composition delta and is the largest authored document by construction; a report states ordered bindings and prose, so its scalars are allowed to be longer while its structure stays flatter. The other three sit between, and every cap is the smallest number the corpus actually needs.",
  "layers": {
    "training": {
      "max_bytes": 8192,
      "max_scalar_bytes": 512,
      "max_ast_nodes": 160,
      "max_depth": 16,
      "max_items": 32,
      "max_object_keys": 32,
      "max_assertions": 4,
      "project_caps": {
        "max_rows": 2
      }
    },
    "evaluation": {
      "max_bytes": 4096,
      "max_scalar_bytes": 512,
      "max_ast_nodes": 120,
      "max_depth": 12,
      "max_items": 32,
      "max_object_keys": 32,
      "max_assertions": 4
    },
    "analysis": {
      "max_bytes": 4096,
      "max_scalar_bytes": 512,
      "max_ast_nodes": 120,
      "max_depth": 12,
      "max_items": 32,
      "max_object_keys": 32,
      "max_assertions": 4
    },
    "figure": {
      "max_bytes": 4096,
      "max_scalar_bytes": 512,
      "max_ast_nodes": 120,
      "max_depth": 12,
      "max_items": 32,
      "max_object_keys": 32,
      "max_assertions": 4
    },
    "comparison": {
      "max_bytes": 4096,
      "max_scalar_bytes": 512,
      "max_ast_nodes": 120,
      "max_depth": 12,
      "max_items": 32,
      "max_object_keys": 32,
      "max_assertions": 4
    },
    "report": {
      "max_bytes": 8192,
      "max_scalar_bytes": 4096,
      "max_ast_nodes": 120,
      "max_depth": 10,
      "max_items": 32,
      "max_object_keys": 32,
      "max_assertions": 2
    }
  }
}
