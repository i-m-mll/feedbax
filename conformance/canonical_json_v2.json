{
  "schema_id": "feedbax.conformance.canonical_json_v2",
  "schema_version": "feedbax.conformance.canonical_json_v2.v1",
  "algorithm": "canonical_json_v2",
  "cases": [
    {
      "case_id": "ordinary_nested",
      "input": {"form": "json", "value": {"z": [null, true, false, {"b": 2, "a": 1}], "a": "value"}},
      "expected_utf8_hex": "7b2261223a2276616c7565222c227a223a5b6e756c6c2c747275652c66616c73652c7b2261223a312c2262223a327d5d7d"
    },
    {
      "case_id": "integral_float",
      "input": {"form": "json", "value": 1.0},
      "expected_utf8_hex": "31"
    },
    {
      "case_id": "negative_zero",
      "input": {"form": "json", "value": -0.0},
      "expected_utf8_hex": "30"
    },
    {
      "case_id": "lower_decimal_threshold",
      "input": {"form": "json", "value": 0.000001},
      "expected_utf8_hex": "302e303030303031"
    },
    {
      "case_id": "lower_exponent_threshold",
      "input": {"form": "json", "value": 0.0000001},
      "expected_utf8_hex": "31652d37"
    },
    {
      "case_id": "upper_decimal_threshold",
      "input": {"form": "json", "value": 100000000000000000000.0},
      "expected_utf8_hex": "313030303030303030303030303030303030303030"
    },
    {
      "case_id": "upper_exponent_threshold",
      "input": {"form": "json", "value": 1e21},
      "expected_utf8_hex": "31652b3231"
    },
    {
      "case_id": "shortest_round_trip",
      "input": {"form": "json", "value": 333333333.33333329},
      "expected_utf8_hex": "3333333333333333332e33333333333333"
    },
    {
      "case_id": "non_ascii",
      "input": {"form": "json", "value": "café Ελληνικά"},
      "expected_utf8_hex": "22636166c3a920ce95cebbcebbceb7cebdceb9cebaceac22"
    },
    {
      "case_id": "unicode_not_normalized",
      "input": {"form": "json", "value": ["é", "é"]},
      "expected_utf8_hex": "5b22c3a9222c2265cc81225d"
    },
    {
      "case_id": "utf16_key_order",
      "input": {"form": "json", "value": {"": "bmp", "𐀀": "astral"}},
      "expected_utf8_hex": "7b22f0908080223a2261737472616c222c22ee8080223a22626d70227d"
    },
    {
      "case_id": "escape_characters",
      "input": {"form": "json", "value": "\u0000\b\t\n\f\r\"\\"},
      "expected_utf8_hex": "225c75303030305c625c745c6e5c665c725c225c5c22"
    },
    {
      "case_id": "maximum_safe_integer",
      "input": {"form": "json", "value": 9007199254740991},
      "expected_utf8_hex": "39303037313939323534373430393931"
    },
    {
      "case_id": "unsafe_integer",
      "input": {"form": "json", "value": 9007199254740992},
      "expected_error": "unsafe_integer"
    },
    {
      "case_id": "nan",
      "input": {"form": "special", "name": "nan"},
      "expected_error": "non_finite_number"
    },
    {
      "case_id": "positive_infinity",
      "input": {"form": "special", "name": "positive_infinity"},
      "expected_error": "non_finite_number"
    },
    {
      "case_id": "negative_infinity",
      "input": {"form": "special", "name": "negative_infinity"},
      "expected_error": "non_finite_number"
    },
    {
      "case_id": "lone_surrogate",
      "input": {"form": "json", "value": "\ud800"},
      "expected_error": "lone_surrogate"
    },
    {
      "case_id": "non_string_key",
      "input": {"form": "special", "name": "non_string_key"},
      "expected_error": "non_string_key"
    },
    {
      "case_id": "unsupported_leaf",
      "input": {"form": "special", "name": "unsupported_leaf"},
      "expected_error": "unsupported_type"
    },
    {
      "case_id": "array_cycle",
      "input": {"form": "special", "name": "array_cycle"},
      "expected_error": "cycle"
    }
  ]
}
